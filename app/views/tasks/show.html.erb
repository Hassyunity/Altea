<% content_for :title, "#{@task.title} — Altea" %>

<header class="page-head">
  <div>
    <span class="page-head__eyebrow">
      <%= area_meta(life_area)[:label] %> · <%= status_label(@task.status) %>
    </span>
    <h1><%= @task.title %></h1>
    <p class="page-head__sub">
      <% if @task.due_on %>Échéance : <%= due_label(@task.due_on) %> · <% end %>
      Priorité <%= priority_label(@task.priority).downcase %>
      <% if @task.project %> · <%= link_to @task.project.name, project_path(@task.project), class: "panel__link" %><% end %>
    </p>
  </div>
  <div class="page-head__actions">
    <%= button_to @task.done? ? "Rouvrir" : "Marquer terminée", toggle_task_path(@task),
          method: :patch, class: "btn btn--primary" %>
    <%= link_to "Éditer", edit_task_path(@task), class: "btn" %>
  </div>
</header>

<section class="panel">
  <% if @task.details.present? %>
    <div class="note-body"><%= @task.details %></div>
  <% else %>
    <div class="empty">Pas de détails pour cette tâche.</div>
  <% end %>
</section>
